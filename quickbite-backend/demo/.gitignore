# ==============================
# QuickBite - Root Git Ignore
# ==============================

# ------------------------------
# Environment & Secrets
# ------------------------------
.env
.env.*
!.env.example

# Backend local configuration / secrets
**/src/main/resources/application-local.properties
**/src/main/resources/application.properties.backup
**/*.secret
**/*.key
**/*.pem

# ------------------------------
# Java / Spring Boot
# ------------------------------
**/target/
**/.mvn/wrapper/maven-wrapper.jar

# ------------------------------
# Node / React
# ------------------------------
**/node_modules/
**/build/
**/.cache/

# ------------------------------
# Logs
# ------------------------------
*.log

# ------------------------------
# IDE
# ------------------------------
.vscode/
.idea/
*.iml
*.iws
*.ipr

# ------------------------------
# OS
# ------------------------------
.DS_Store
Thumbs.db

# ------------------------------
# Temporary files
# ------------------------------
*.tmp
*.temp
*.bak
*~

# ------------------------------
# Local Maven / temporary files
# ------------------------------
**/apache-maven-3.9.16/
**/apache-maven-3.9.16-bin.zip
**/maven.zip
**/classpath.txt

# Temporary test files
**/SmtpTest.java